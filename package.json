{
  "name": "job-apply-agent",
  "version": "1.0.0",
  "description": "AI-powered job application agent that finds, tailors, applies, and tracks jobs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "node server.js",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "next build --type-check-only",
    "typecheck:watch": "tsc --noEmit --watch",
    "validate": "npm run lint && npm run typecheck",
    "test": "jest --testPathPattern=src/shared/__tests__ --coverage --coverageReport=json --coverageReport=lcov",
    "test:integration": "jest --testPathPattern=src/app/api/__tests__ --testTimeout=30000",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e",
    "test:watch": "jest --watch",
    "migrate": "node scripts/migrate.js",
    "migrate:rollback": "node scripts/rollback.js",
    "worker": "node workers/index.js",
    "worker:dev": "node workers/index.js",
    "queue:stats": "curl http://localhost:3000/api/queue/stats",
    "queue:clean": "node scripts/clean-queues.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/auth-helpers-react": "^0.15.0",
    "@supabase/supabase-js": "^2.39.0",
    "autoprefixer": "^10.4.0",
    "axios": "^1.6.0",
    "bullmq": "^5.76.2",
    "cheerio": "^1.0.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.0.0",
    "dotenv": "^16.4.0",
    "framer-motion": "^11.0.0",
    "googleapis": "^171.4.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.363.0",
    "next": "^14.2.35",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.7",
    "openai": "^4.28.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.42.0",
    "postcss": "^8.4.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.4.0",
    "uuid": "^14.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.2.35",
    "typescript": "6.0.3"
  }
}
